        }
      },
      "id": "a508d708973f4d55",
      "name": "스케줄(매일 08시)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 요일 분산: 하루 1채널씩 (Gemini 무료 한도 20/일 회피)\n// getDay(): 0=일 1=월 2=화 3=수 4=목 5=금 6=토\nconst dow = new Date().getDay();\nconst byDay = {\n  1: ['105'], // 월 — 안지아(보안)\n  2: ['110'], // 화 — 정세윤(테크)\n  3: ['111'], // 수 — 지서아(공간)\n  4: ['102'], // 목 — 오세련(골프)\n  5: ['103'], // 금 — 왕세림(테니스)\n};\nconst channels = byDay[dow] || []; // 토·일은 쉼\nreturn channels.map(id => ({ json: { channel_id: id } }));"
      },
      "id": "2d380466c9504ef5",
      "name": "채널 목록",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://shortcrew.co.kr/admin/api/ops/bridge/curate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ops-Token",
              "value": "<OPS_API_TOKEN>"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel_id: $json.channel_id, dry_run: false, auto_blog: true, auto_dm: true }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "31e5ab5a44354b23",
      "name": "큐레이션 호출 (/bridge/curate)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
