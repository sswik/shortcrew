      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "<DISCORD_WEBHOOK_URL>",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: '🛒 **큐레이션** ch' + $json.channel_id + ' — 상품 ' + ($json.written_to_sheet || 0) + '건 / 블로그 ' + ($json.blogs_created || 0) + '건 적재' }) }}",
        "options": {}
