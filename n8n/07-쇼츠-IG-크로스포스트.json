    {
      "parameters": {
        "jsCode": "// ▼▼ 채널마다 이 3개만 바꾸면 됨 ▼▼\nconst channel_id = '105';                       // 채널ID\nconst base_url   = 'https://shortcrew.co.kr';   // shortcrew 채널=shortcrew.co.kr / 지식쇼츠=short-mall 주소\n// (영상시트 documentId 는 '영상시트 읽기' 노드에서 채널별로 변경)\n// ▲▲ ---------------------------------- ▲▲\n// 렌더+유튜브 완료 & 아직 IG 미발행(ig_url 빈칸)만\nreturn $input.all().map(i => i.json)\n  .filter(r => r['drive_video_id'] && r['youtube_url'] && !r['ig_url'])\n  .map(r => ({ json: {\n      channel_id, base_url,\n      no: r['No'],\n      drive_video_id: String(r['drive_video_id']).trim(),\n      caption: (r['등록설명'] || r['제목'] || '').toString(),\n  }}));"
      },
      "id": "4a02a477e00f46c6",
      "name": "발행 대상 필터",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "share",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.drive_video_id }}"
        },
        "permissionsUi": {
          "permissionsValues": {
            "role": "reader",
            "type": "anyone"
          }
        },
        "options": {}
      },
      "id": "d0447ab2104e4214",
      "name": "Drive 공개(anyone)",
