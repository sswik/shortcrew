# 숏크루 (Shortcrew) — 환경 변수 예시 · 레포/도메인: shortcrew
# 사용: cp .env.example .env 후 값만 채운다. .env 는 git 에 커밋하지 않는다.

# =============================================================================
# Cloudflare Tunnel (docker compose --profile tunnel)
# =============================================================================
# Cloudflare Zero Trust → Networks → Tunnels 에서 발급한 토큰 문자열만. git·채팅에 넣지 말 것.
# `docker run ... --token` 전체가 아니라 JWT 형태의 토큰 한 덩어리만 넣는다.
# compose 가 이 값을 cloudflared 컨테이너의 TUNNEL_TOKEN 으로 넘긴다.
CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# 백오피스 (/admin)
# =============================================================================
# ADMIN_PASSWORD 가 비어 있으면 로컬에서 백오피스 무인증(개발용).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 앱 기본 실행값(선택)
APP_NAME=
APP_HOST=
APP_PORT=
APP_DOMAIN=

# 공개 사이트 베이스 URL(끝 슬래시 없이). 비우면 HTTP 요청의 Host 를 사용한다.
# 공개 몰(`/{name_slug}`) 페이지에 내려가는 몰 상품 프록시 URL을 절대 경로로 만들고, 시트 딥링크 미리보기의 mall_shop_url 계산에도 쓰인다.
PUBLIC_SITE_URL=

# DB 경로를 외부에서 주입하고 싶을 때(선택)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/crews
DATABASE_URL_CONTAINER=mysql+pymysql://USER:PASSWORD@mysql-server:3306/crews

# =============================================================================
# 채널·시트 (자세한 절차: docs/01_CHANNEL_GUIDE.md)
# =============================================================================
# google-key.json(서비스 계정): 백오피스가 **Google Sheets API**로 시트를 읽고/쓸 때 사용. Apps Script “웹앱 배포 URL”과는 별개.
#
# --- Apps Script URL: sample/short-mall-template 과 뭐가 다른지 ---
# 샘플(.env.template)에는 **한 줄**만 있음: APPS_SCRIPT_WEB_APP_URL → config.js 의 apiUrl.
#   → 쇼핑몰 **브라우저**만 fetch(GET)으로 상품 JSON을 가져옴(doGet 웹앱). 시트에 행 넣는 건 그 샘플 밖(예: 별도 ops)에서 한다고 가정.
# 숏크루(shortcrew) 은 그 위에 **백오피스 서버**가 시트에 행을 넣은 직후, 같은/다른 스크립트로 **JSON POST**를 보낼 수 있게
#   CHANNEL_*_PRODUCT_DELIVERY_WEBAPP_URL 을 둠. “딜리버리”는 **서버→스크립트** 방향.
# 몰 화면(공개 `/{name_slug}`)은 샘플과 같이 **브라우저 GET** 이므로 CHANNEL_*_MALL_PRODUCTS_API_URL 이 그 역할.
# doPost(서버 웹훅)를 **안 쓰면** PRODUCT_DELIVERY 는 **비워도 됨** — 시트에 쓰는 건 google-key Sheets API라서 “가짜”로 둘 필요 없음.
# 몰만 있으면: (1) MALL 에만 doGet URL 넣거나 (2) MALL 비우고 PRODUCT 에 doGet URL 한 줄만 넣어도 폴백으로 몰 GET에 쓰임. (3) 둘 다 같은 URL 넣어도 됨.
#
# | env (shortcrew) | 누가 | 메서드 | sample/short-mall-template 에 대응 |
# |----------------|------|--------|--------------------------------------|
# | CHANNEL_*_PRODUCT_DELIVERY_WEBAPP_URL | FastAPI 서버(시트 전송 직후) | POST JSON | 없음(샘플 정적 몰만 있으면 불필요·비워도 됨) |
# | CHANNEL_*_MALL_PRODUCTS_API_URL | 방문자 브라우저(공개 몰) | GET ?channel= | ≈ APPS_SCRIPT_WEB_APP_URL (= doGet 배포 URL) |
#
# channel_id 102 — 오세련픽(골프) / docs/01_CHANNEL_GUIDE.md
CHANNEL_102_FILE_ID=
CHANNEL_102_TAB=
CHANNEL_102_HISTORY_TAB=
CHANNEL_102_PRODUCT_DELIVERY_WEBAPP_URL=
CHANNEL_102_MALL_INFLUENCER_SLUG=
CHANNEL_102_MALL_PRODUCTS_API_URL=

# channel_id 103 — 왕세림픽(테니스) / docs/01_CHANNEL_GUIDE.md
CHANNEL_103_FILE_ID=
CHANNEL_103_TAB=
CHANNEL_103_HISTORY_TAB=
CHANNEL_103_PRODUCT_DELIVERY_WEBAPP_URL=
CHANNEL_103_MALL_INFLUENCER_SLUG=
CHANNEL_103_MALL_PRODUCTS_API_URL=
CHANNEL_103_MALL_PRODUCTS_CHANNEL_PARAM=

# channel_id 104 — 한소율픽(쇼핑) / docs/01_CHANNEL_GUIDE.md
CHANNEL_104_FILE_ID=
CHANNEL_104_TAB=
CHANNEL_104_HISTORY_TAB=
CHANNEL_104_PRODUCT_DELIVERY_WEBAPP_URL=
CHANNEL_104_MALL_INFLUENCER_SLUG=
CHANNEL_104_MALL_PRODUCTS_API_URL=
CHANNEL_104_MALL_PRODUCTS_CHANNEL_PARAM=

# channel_id 104 — 쇼츠 시트 트리거 리뷰 자동화 (docs/06_SHORTS_SHEET_REVIEWS.md)
# 1=true/yes/on 이면 활성. 기획 탭 이름·상품 탭은 실제 스프레드시트와 동일하게.
CHANNEL_104_SHORTS_AUTOMATION_ENABLED=
CHANNEL_104_SHORTS_PLAN_TAB=
# 비우면 CHANNEL_104_TAB(상품목록) 과 동일
CHANNEL_104_SHORTS_PRODUCT_TAB=
CHANNEL_104_SHORTS_PLAN_RANGE=A:W
CHANNEL_104_SHORTS_PRODUCT_RANGE=A:K
CHANNEL_104_SHORTS_PLAN_STATUS_VALUE=완료
CHANNEL_104_SHORTS_PRODUCT_STATUS_VALUE=게시중
CHANNEL_104_SHORTS_COL_PLAN_STATUS=C
CHANNEL_104_SHORTS_COL_PLAN_DATE=D
CHANNEL_104_SHORTS_PLAN_DATE_TZ=Asia/Seoul
CHANNEL_104_SHORTS_COL_PLAN_YOUTUBE=W
CHANNEL_104_SHORTS_COL_PLAN_PRODUCT=F
CHANNEL_104_SHORTS_COL_PRODUCT_STATUS=I
CHANNEL_104_SHORTS_COL_PRODUCT_NAME=C
CHANNEL_104_SHORTS_COL_PRODUCT_DEEPLINK=G

# channel_id 102 — 쇼츠 시트 트리거 리뷰 자동화
CHANNEL_102_SHORTS_AUTOMATION_ENABLED=
CHANNEL_102_SHORTS_PLAN_TAB=
CHANNEL_102_SHORTS_PRODUCT_TAB=
CHANNEL_102_SHORTS_PLAN_RANGE=A:W
CHANNEL_102_SHORTS_PRODUCT_RANGE=A:K
CHANNEL_102_SHORTS_PLAN_STATUS_VALUE=완료
CHANNEL_102_SHORTS_PRODUCT_STATUS_VALUE=게시중
CHANNEL_102_SHORTS_COL_PLAN_STATUS=C
CHANNEL_102_SHORTS_COL_PLAN_DATE=D
CHANNEL_102_SHORTS_PLAN_DATE_TZ=Asia/Seoul
CHANNEL_102_SHORTS_COL_PLAN_YOUTUBE=W
CHANNEL_102_SHORTS_COL_PLAN_PRODUCT=F
CHANNEL_102_SHORTS_COL_PRODUCT_STATUS=I
CHANNEL_102_SHORTS_COL_PRODUCT_NAME=C
CHANNEL_102_SHORTS_COL_PRODUCT_DEEPLINK=G
CHANNEL_102_SHORTS_AUTO_PRODUCT_FALLBACK_ENABLED=1
CHANNEL_102_SHORTS_AUTO_PRODUCT_SEARCH_LIMIT=5

# channel_id 103 — 쇼츠 시트 트리거 리뷰 자동화
CHANNEL_103_SHORTS_AUTOMATION_ENABLED=
CHANNEL_103_SHORTS_PLAN_TAB=
CHANNEL_103_SHORTS_PRODUCT_TAB=
CHANNEL_103_SHORTS_PLAN_RANGE=A:W
CHANNEL_103_SHORTS_PRODUCT_RANGE=A:K
CHANNEL_103_SHORTS_PLAN_STATUS_VALUE=완료
CHANNEL_103_SHORTS_PRODUCT_STATUS_VALUE=게시중
CHANNEL_103_SHORTS_COL_PLAN_STATUS=C
CHANNEL_103_SHORTS_COL_PLAN_DATE=D
CHANNEL_103_SHORTS_PLAN_DATE_TZ=Asia/Seoul
CHANNEL_103_SHORTS_COL_PLAN_YOUTUBE=W
CHANNEL_103_SHORTS_COL_PLAN_PRODUCT=F
CHANNEL_103_SHORTS_COL_PRODUCT_STATUS=I
CHANNEL_103_SHORTS_COL_PRODUCT_NAME=C
CHANNEL_103_SHORTS_COL_PRODUCT_DEEPLINK=G
CHANNEL_103_SHORTS_AUTO_PRODUCT_FALLBACK_ENABLED=1
CHANNEL_103_SHORTS_AUTO_PRODUCT_SEARCH_LIMIT=5

# =============================================================================
# 운영 JSON API (/admin/api/ops) — 외부 서비스 키
# =============================================================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 공개 몰「바로 구매하기」쿠팡 링크에 붙는 파트너스 lptag(예: AF3048427). 비우면 lptag 쿼리를 넣지 않음.
# (별칭) COUPANG_LPTAG 로만 넣어도 동일하게 읽습니다.
COUPANG_PARTNERS_LPTAG=

# 공개 몰 썸네일: 쿠팡 이미지 앞에 붙는 Workers 베이스 URL(끝 슬래시 없이). 채널별 아님 — 전역 한 변수만.
# 비우면 기본: https://image.shortcrew.co.kr/
COUPANG_IMAGE_WORKER_BASE=

GOOGLE_GEMINI_KEY=

# YouTube Data API (쇼츠 자막 실패 시 제목·설명 폴백). git·채팅에 키 값을 넣지 말 것.
YOUTUBE_API_KEY=
# shortcrew 등에서 POST /admin/api/ops/mall/click 호출 시 검증(비우면 토큰 검사 안 함)
MALL_CLICK_LOG_AUTH_TOKEN=

# =============================================================================
# 구글 시트
# =============================================================================
# 실제 API 호출은 프로젝트 루트의 google-key.json(서비스 계정 JSON)을 사용한다.
# 아래는 /admin/sheets 화면의「설정됨」표시용(선택). JSON 문자열 전체를 넣는 방식이면 값이 길어질 수 있다.
GOOGLE_SERVICE_ACCOUNT_JSON=

# =============================================================================
# Instagram 댓글 → 자동 DM (shortcrew 전용 Meta 앱 / docs/09 · docs/10 참고)
# =============================================================================
# 앱 공통 (short-mall 과 분리된 별도 Meta 앱)
IG_APP_ID=
# 앱 시크릿(개발자센터 '표시'에서 복사). git·채팅에 값 노출 금지.
IG_APP_SECRET=
# Webhooks '인증 토큰'과 동일하게 채울 비밀 문자열
IG_WEBHOOK_VERIFY_TOKEN=
IG_GRAPH_API_VERSION=v21.0

# 채널별 IG 계정(인플루언서). 한 계정은 ID가 두 개다(GET /me?fields=id,user_id,username):
#  · ACCOUNT_ID    = user_id (네이티브 IG 계정 ID) — /media·/messages 등 Graph 호출용
#  · APP_SCOPED_ID = id      (앱스코프 ID) — 웹훅 entry.id/from.id 가 이 값으로 올 수 있음
# 웹훅은 두 ID 모두로 채널 해석·본인(루프) 판정한다. APP_SCOPED_ID 는 선택(있으면 견고).
# 아래는 채널 102 예시 — 운영 채널 수만큼 반복.
CHANNEL_102_IG_USERNAME=
CHANNEL_102_IG_ACCOUNT_ID=
CHANNEL_102_IG_APP_SCOPED_ID=
CHANNEL_102_IG_ACCESS_TOKEN=
# 채널 추가 시 같은 4줄을 채널번호만 바꿔 반복 (예: 안지아=105)
# CHANNEL_105_IG_USERNAME=
# CHANNEL_105_IG_ACCOUNT_ID=     (= graph /me 의 user_id, 발행 경로 /{id}/media 에 사용)
# CHANNEL_105_IG_APP_SCOPED_ID=
# CHANNEL_105_IG_ACCESS_TOKEN=

# ── n8n → FastAPI 호출용 공유 토큰 ──────────────────────────────
# 인스타 릴스 발행 등 ops 엔드포인트를 n8n이 부를 때 X-Ops-Token 헤더로 보낸다.
# 비워두면 해당 엔드포인트는 503(미설정)으로 막힌다. 임의 난수로 채울 것.
OPS_API_TOKEN=
